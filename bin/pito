#!/usr/bin/env sh
# bin/pito — deprecation shim. The operator CLI is now `pito-cli`.
# Kept for one release of grace; will be removed. Execs the real CLI beside it.
printf '%s\n' "pito: the operator CLI is now 'pito-cli' — run pito-cli (this shim is removed next release)." >&2
CDPATH=''  # neutralize CDPATH so `cd` never jumps unexpectedly
dir=$(cd -- "$(dirname -- "$0")" && pwd)
exec "$dir/pito-cli" "$@"
